apiVersion: v1
kind: Pod
metadata:
  name: ${POD_NAME}
  namespace: ${CI_NAMESPACE}
  labels:
    qrl.io/lane: soak
    qrl.io/role: report
    qrl.io/run: "${RUN_ID}"
spec:
  # Mounts the report volume and is exec'ed into; needs no identity, and
  # the admission policy would refuse busybox as qrl-job anyway.
  serviceAccountName: default
  automountServiceAccountToken: false
  restartPolicy: Never
  nodeSelector:
    qrl.io/pool: core
  containers:
    - name: collect
      image: public.ecr.aws/docker/library/busybox:1.37
      command: ["sleep", "600"]
      volumeMounts:
        - name: reports
          mountPath: /reports
          readOnly: true
  volumes:
    - name: reports
      persistentVolumeClaim:
        claimName: ${JOB_NAME}-reports
