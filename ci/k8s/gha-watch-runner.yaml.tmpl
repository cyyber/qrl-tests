# Ephemeral self-hosted runner that exists only while a soak is in flight.
# soak.yml's watch job pins to this pod via the qrl-watch-${RUN_ID} label so
# the Actions run stays in progress without a GitHub-hosted runner.
# envsubst must only expand RUN_ID, CI_NAMESPACE and GITHUB_REPOSITORY.
# ${GH_URL} / ${RUNNER_NAME} / ${RUNNER_LABELS} are pod env.
#
# The runner is registered to a public repository, so it is treated as
# hostile: it runs as the read-only qrl-watch service account (never
# qrl-job), carries only its run-specific label (--no-default-labels, so a
# fork PR's runs-on: self-hosted cannot land here), runs a digest-pinned
# image, and reads its registration token from a Secret that soak.yml
# creates for this run and deletes afterwards.
apiVersion: batch/v1
kind: Job
metadata:
  name: qrl-watch-${RUN_ID}
  namespace: ${CI_NAMESPACE}
  labels:
    qrl.io/lane: soak
    qrl.io/component: gha-watch
    qrl.io/run: "${RUN_ID}"
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 3600
  activeDeadlineSeconds: 36000
  template:
    metadata:
      labels:
        qrl.io/lane: soak
        qrl.io/component: gha-watch
        qrl.io/run: "${RUN_ID}"
    spec:
      serviceAccountName: qrl-watch
      restartPolicy: Never
      nodeSelector:
        qrl.io/pool: core
        kubernetes.io/arch: arm64
      securityContext:
        fsGroup: 1001
      containers:
        - name: runner
          # actions-runner:latest as of 2026-09-07 (Ubuntu 24.04 base).
          image: ghcr.io/actions/actions-runner@sha256:f5a0d9a3d857315f2aed7075a02a29f46927ad198221c3b1c66585ae9fe36c0d
          imagePullPolicy: IfNotPresent
          env:
            - name: RUNNER_ALLOW_RUNASROOT
              value: "0"
            - name: GH_URL
              value: https://github.com/${GITHUB_REPOSITORY}
            - name: RUNNER_NAME
              value: qrl-watch-${RUN_ID}
            - name: RUNNER_LABELS
              value: qrl-watch-${RUN_ID}
            - name: RUNNER_TOKEN
              valueFrom:
                secretKeyRef:
                  name: qrl-watch-${RUN_ID}
                  key: token
          command: ["/bin/bash", "-lc"]
          args:
            - |
              set -euo pipefail
              cd /home/runner
              ./config.sh --unattended --ephemeral --disableupdate \
                --url "${GH_URL}" \
                --token "${RUNNER_TOKEN}" \
                --name "${RUNNER_NAME}" \
                --labels "${RUNNER_LABELS}" \
                --no-default-labels \
                --replace
              exec ./run.sh
          resources:
            requests:
              cpu: "100m"
              memory: 256Mi
            limits:
              memory: 512Mi
