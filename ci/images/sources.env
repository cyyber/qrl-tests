# shellcheck shell=bash disable=SC2034 # Variables are consumed by build.sh.
# Pinned sources and immutable bases for the CI-built devnet support images.
# Every value here participates in the image cache keys, so changing any line
# rebuilds the affected images on the next nightly; nothing else does. Build
# layer caches live beside each package as its :buildcache tag, and the
# ghcr-retention workflow prunes superseded versions weekly.
#
# The qrysm revision is not pinned here: both clients under test resolve to
# their upstream tips in the nightly. The generator is pinned because its
# 64-byte address migration exists only in this fork so far; once those
# commits land in cyyber/qrl-genesis-generator, resolve it like the clients.
GENERATOR_GIT_REPO='https://github.com/rgeraldes24/qrl-genesis-generator.git'
GENERATOR_GIT_COMMIT='3884e4228ef347bbfa4a80a90e819cd05140f122'
# The published consensus and generator images supply immutable runtime
# filesystems only; their pre-VM64 binaries and sources are always replaced
# from the pinned revisions above before anything runs them.
QRYSM_CL_BASE_IMAGE='qrledger/qrysm:beacon-chain-latest@sha256:52b6fbecfe442d0d451e1219652e464d69de8a09edd44d5c54bbbf5ebdb83000'
QRYSM_VC_BASE_IMAGE='qrledger/qrysm:validator-latest@sha256:e830b41130a43211803fe3d17eeb0a66cd743f062d5407667ee3531bc5891ede'
GENESIS_BASE_IMAGE='qrledger/qrysm:qrl-genesis-generator-latest@sha256:43d975e6b5e22e4de79d9027325cc05f996c2325705f2e199e012788e5faa0eb'
# Match the Bookworm runtime in the generator base so CGO-linked binaries
# never depend on a newer glibc. The Go version must satisfy the resolved
# qrysm revision's go.mod: builds run GOTOOLCHAIN=local, so a toolchain
# bump upstream is a reviewed bump here, never a silent download.
QRYSM_GO_BUILDER_IMAGE='golang:1.26-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd'
GENESIS_GO_BUILDER_IMAGE='golang:1.26-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd'
