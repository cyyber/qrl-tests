// SPDX-License-Identifier: LGPL-3.0
pragma hyperion >=0.1.0;

contract ConsoleProbe {
    event Deployed(uint256 value);
    event Stored(
        address indexed sender,
        string indexed label,
        bytes indexed payload,
        uint512 value
    );
    uint512 public stored;
    address public constructorRecipient;
    bytes33 public constructorTag;
    bytes32 public constructorPayloadHash;

    constructor(
        uint512 amount,
        address recipient,
        bytes33 tag,
        bytes memory payload
    ) {
        stored = amount;
        constructorRecipient = recipient;
        constructorTag = tag;
        constructorPayloadHash = keccak256(payload);
        emit Deployed(1337);
    }

    function echo(
        uint512 amount,
        int512 delta,
        bytes64 tag,
        address recipient,
        bytes calldata payload,
        string calldata note,
        bool enabled
    ) external pure returns (
        uint512,
        int512,
        bytes64,
        address,
        bytes memory,
        string memory,
        bool
    ) {
        return (amount, delta, tag, recipient, payload, note, enabled);
    }

    function echoFixed(
        bytes1 value1,
        bytes32 value32,
        bytes33 value33,
        bytes64 value64
    ) external pure returns (bytes1, bytes32, bytes33, bytes64) {
        return (value1, value32, value33, value64);
    }

    function echoArrays(
        uint512[] calldata values,
        bytes64[2] calldata tags
    ) external pure returns (uint512[] memory, bytes64[2] memory) {
        return (values, tags);
    }

    function overloaded(uint512 value) external pure returns (uint512) {
        return value + 1;
    }

    function overloaded(bytes33 value) external pure returns (bytes33) {
        return value;
    }

    function failReason() external pure {
        revert("console wrapper revert");
    }

    function store(
        uint512 value,
        string calldata label,
        bytes calldata payload
    ) external {
        stored = value;
        emit Stored(msg.sender, label, payload, value);
    }

    function pay(uint512 marker) external payable {
        stored = marker + msg.value;
    }

    function failTransaction() external {
        revert("console transaction revert");
    }
}
